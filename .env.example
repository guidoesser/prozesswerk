# LLM API Konfiguration
# Einen beliebigen OpenAI-kompatiblen API-Key eintragen
LLM_API_KEY=dein-api-key-hier

# Optional: eigener Base URL (z.B. für OpenRouter, lokale LLMs, etc.)
LLM_BASE_URL=https://api.openai.com/v1

# Optional: Model-Name (z.B. gpt-4o, claude-3-opus-20240229, etc.)
LLM_MODEL=gpt-4o
